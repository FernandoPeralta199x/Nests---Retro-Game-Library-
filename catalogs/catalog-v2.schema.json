{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nests.example/schemas/catalog-v2.schema.json",
  "title": "NESTS Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "generated_at", "catalog_name", "trusted_download_hosts", "items"],
  "properties": {
    "schema_version": { "const": 2 },
    "catalog_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "catalog_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "trusted_download_hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
    },
    "items": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "system", "genre", "year", "region", "description", "cover_url", "format", "size_bytes", "source_name", "source_url", "download_url", "distribution_status", "rights", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "system": { "type": "string", "minLength": 1, "maxLength": 80 },
          "genre": { "type": "string", "minLength": 1, "maxLength": 80 },
          "year": { "type": "integer", "minimum": 1970, "maximum": 2100 },
          "region": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 4000 },
          "cover_url": { "type": ["string", "null"], "format": "uri" },
          "format": { "type": "string", "pattern": "^\\.[a-z0-9]{2,8}$" },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
          "source_name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "source_url": { "type": ["string", "null"], "format": "uri" },
          "download_url": { "type": ["string", "null"], "format": "uri" },
          "distribution_status": { "enum": ["demo_only", "verified"] },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["license_id", "license_url", "evidence_url", "redistribution_allowed"],
            "properties": {
              "license_id": { "type": ["string", "null"], "maxLength": 160 },
              "license_url": { "type": ["string", "null"], "format": "uri" },
              "evidence_url": { "type": ["string", "null"], "format": "uri" },
              "redistribution_allowed": { "type": "boolean" }
            }
          },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    }
  }
}
